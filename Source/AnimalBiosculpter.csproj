<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <PackageId>bodilpwnz.AnimalBiosculpter</PackageId>
        <Version>1.0.1</Version>
        <Authors>Bodil Stokke</Authors>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>

        <OutputType>Library</OutputType>
        <LangVersion>10.0</LangVersion>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0</TargetFramework>
        <OutputPath>..\Mod\1.7\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <Target Name="Rimworld14" AfterTargets="Build">
        <MSBuild Projects="$(MSBuildProjectFile)"
            Targets="Restore"
            Properties="MSBuildProjectExtensionsPath=$(MSBuildProjectDirectory)\obj\1.4\;DefineConstants=RIMWORLD_1_4;TargetFramework=net48" />
        <MSBuild Projects="$(MSBuildProjectFile)"
            Targets="Build"
            Properties="MSBuildProjectExtensionsPath=$(MSBuildProjectDirectory)\obj\1.4\;OutputPath=..\Mod\1.4\Assemblies;DefineConstants=RIMWORLD_1_4;TargetFramework=net48" />
    </Target>

    <Target Name="Rimworld15" AfterTargets="Build">
        <MSBuild Projects="$(MSBuildProjectFile)"
            Targets="Restore"
            Properties="MSBuildProjectExtensionsPath=$(MSBuildProjectDirectory)\obj\1.5\;DefineConstants=RIMWORLD_1_5;TargetFramework=net48" />
        <MSBuild Projects="$(MSBuildProjectFile)"
            Targets="Build"
            Properties="MSBuildProjectExtensionsPath=$(MSBuildProjectDirectory)\obj\1.5\;OutputPath=..\Mod\1.5\Assemblies;DefineConstants=RIMWORLD_1_5;TargetFramework=net48" />
    </Target>

    <Target Name="Rimworld16" AfterTargets="Build">
        <MSBuild Projects="$(MSBuildProjectFile)"
            Targets="Restore"
            Properties="MSBuildProjectExtensionsPath=$(MSBuildProjectDirectory)\obj\1.6\;DefineConstants=RIMWORLD_1_6;TargetFramework=net48" />
        <MSBuild Projects="$(MSBuildProjectFile)"
            Targets="Build"
            Properties="MSBuildProjectExtensionsPath=$(MSBuildProjectDirectory)\obj\1.6\;OutputPath=..\Mod\1.6\Assemblies;DefineConstants=RIMWORLD_1_6;TargetFramework=net48" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony" Version="2.*" />
        <!-- Provides the .NET Framework 4.8 targeting pack for the net48
             builds when building on non-Windows platforms. -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3"
            PrivateAssets="all" />
    </ItemGroup>

    <Choose>
        <When Condition="$(DefineConstants.Contains('RIMWORLD_1_4'))">
            <ItemGroup>
                <PackageReference Include="Krafs.Rimworld.Ref" Version="1.4.*" />
            </ItemGroup>
        </When>
        <When Condition="$(DefineConstants.Contains('RIMWORLD_1_5'))">
            <ItemGroup>
                <PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.*" />
            </ItemGroup>
        </When>
        <When Condition="$(DefineConstants.Contains('RIMWORLD_1_6'))">
            <ItemGroup>
                <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup>
                <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
            </ItemGroup>
        </Otherwise>
    </Choose>

</Project>
